<!-- Caydn Baldwin, Brady Bates, Jacob Woodward, Peter Young -->
<!-- Description: This page is where users that have just signed up fill in the rest of their
 user information such as address, phone number, gender, etc. This information is stored as part of their
 person information.  -->

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Montserrat:wght@300;400;600;700&display=swap" rel="stylesheet">
  <title>Onboarding</title>
  <style>
    /* Theme variables and Bootstrap overrides for onboarding */
    :root {
      --color-white: #FFFFFF;
      --color-light-gray: #D9D9D9;
      --color-black: #070707;
      --color-gray: #696D7D;
      --bs-body-bg: var(--color-white);
      --bs-body-color: var(--color-black);
      --bs-primary: var(--color-black);
      --bs-primary-rgb: 0, 0, 0;
      --bs-secondary: var(--color-gray);
      --bs-secondary-rgb: 105, 109, 125;
      --bs-light: var(--color-light-gray);
      --bs-light-rgb: 217, 217, 217;
      --bs-body-font-family: 'Montserrat', sans-serif;
      --bs-heading-font-family: 'DM Serif Display', serif;
      --bs-gradient: linear-gradient(135deg, var(--color-black), var(--color-gray));
    }

    /* Accent text color for success/positive messages */
    .greentext {
      color: #029107 !important;
    }

    /* Labels styled for readability and consistency */
    .form-label {
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

  </style>
</head>
<body class="min-vh-100 d-flex align-items-center bg-primary">
  <!-- Back Link -->
  <a href="/" aria-label="Back" class="position-fixed top-0 start-0 m-3 z-3 btn btn-light text-primary rounded-pill shadow border-0 d-inline-flex align-items-center gap-2 px-3 py-2">
    <span class="fw-bold">←</span>
    <span class="fw-semibold">Back</span>
  </a>

  <div class="container">
    <div class="row justify-content-center">
      <div class="col-12 col-lg-8 col-xl-7">
        <!-- Error banner if onboarding submission fails -->
        <% if (errorMessage !== null && errorMessage !== "") { %>
          <div class="alert alert-danger" role="alert"><%= errorMessage %></div>
        <% } %>

        <!-- Onboarding Form -->
        <div class="card shadow rounded-4 border-0 bg-white">
          <div class="card-body p-4 p-md-5">
            <!-- Form header and helper subtext -->
            <h1 class="h3 mb-3 text-center text-primary fw-bold">Tell Us About You</h1>
            <p class="text-center text-secondary mb-4">Finish onboarding so your friends can find you.</p>
            <!-- Collect basic person information for profile creation -->
            <form action="/persons/onboarding" method="post" class="needs-validation" novalidate>
              <div class="row g-3">
                <div class="col-md-6">
                  <!-- First name input -->
                  <label for="first_name" class="form-label text-dark">First Name</label>
                  <input type="text" id="first_name" name="first_name" class="form-control" placeholder="John" required autofocus>
                </div>
                <div class="col-md-6">
                  <!-- Last name input -->
                  <label for="last_name" class="form-label text-dark">Last Name</label>
                  <input type="text" id="last_name" name="last_name" class="form-control" placeholder="Smith" required>
                </div>

                <div class="col-md-6">
                  <!-- Date of birth input -->
                  <label for="date_of_birth" class="form-label text-dark">Date of Birth</label>
                  <input type="date" id="date_of_birth" name="date_of_birth" class="form-control" required>
                </div>
                <div class="col-md-6">
                  <!-- Phone number input -->
                  <label for="phone_number" class="form-label text-dark">Phone Number</label>
                  <input type="number" id="phone_number" name="phone_number" class="form-control" placeholder="8012221234" required>
                </div>

                <div class="col-md-6">
                  <!-- Gender selection -->
                  <label for="gender" class="form-label text-dark">Gender</label>
                  <select id="gender" name="gender" class="form-select">
                    <option value="Male">Male</option>
                    <option value="Female">Female</option>
                    <option value="Other">Other</option>
                  </select>
                </div>

                <div class="col-12">
                  <!-- Street address input -->
                  <label for="street_address" class="form-label text-dark">Street Address</label>
                  <input type="text" id="street_address" name="street_address" class="form-control" required>
                </div>

                <div class="col-md-6">
                  <!-- City input -->
                  <label for="city" class="form-label text-dark">City</label>
                  <input type="text" id="city" name="city" class="form-control" required>
                </div>
                <div class="col-md-3">
                  <!-- State selection (US states) -->
                  <label for="state" class="form-label text-dark">State</label>
                  <select id="state" name="state" class="form-select">
                    <option value="AL">AL</option>
                    <option value="AK">AK</option>
                    <option value="AZ">AZ</option>
                    <option value="AR">AR</option>
                    <option value="CA">CA</option>
                    <option value="CO">CO</option>
                    <option value="CT">CT</option>
                    <option value="DE">DE</option>
                    <option value="FL">FL</option>
                    <option value="GA">GA</option>
                    <option value="HI">HI</option>
                    <option value="ID">ID</option>
                    <option value="IL">IL</option>
                    <option value="IN">IN</option>
                    <option value="IA">IA</option>
                    <option value="KS">KS</option>
                    <option value="KY">KY</option>
                    <option value="LA">LA</option>
                    <option value="ME">ME</option>
                    <option value="MD">MD</option>
                    <option value="MA">MA</option>
                    <option value="MI">MI</option>
                    <option value="MN">MN</option>
                    <option value="MS">MS</option>
                    <option value="MO">MO</option>
                    <option value="MT">MT</option>
                    <option value="NE">NE</option>
                    <option value="NV">NV</option>
                    <option value="NH">NH</option>
                    <option value="NJ">NJ</option>
                    <option value="NM">NM</option>
                    <option value="NY">NY</option>
                    <option value="NC">NC</option>
                    <option value="ND">ND</option>
                    <option value="OH">OH</option>
                    <option value="OK">OK</option>
                    <option value="OR">OR</option>
                    <option value="PA">PA</option>
                    <option value="RI">RI</option>
                    <option value="SC">SC</option>
                    <option value="SD">SD</option>
                    <option value="TN">TN</option>
                    <option value="TX">TX</option>
                    <option value="UT">UT</option>
                    <option value="VT">VT</option>
                    <option value="VA">VA</option>
                    <option value="WA">WA</option>
                    <option value="WV">WV</option>
                    <option value="WI">WI</option>
                    <option value="WY">WY</option>
                  </select>
                </div>
                <div class="col-md-3">
                  <!-- Postal code input -->
                  <label for="postal_code" class="form-label text-dark">Postal Code</label>
                  <input type="number" id="postal_code" name="postal_code" class="form-control" required>
                </div>
              </div>

              <!-- Submit to complete onboarding -->
              <button type="submit" class="btn btn-primary bg-primary border-0 text-white fw-semibold w-100 mt-4">Onboard</button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
</body>
</html>