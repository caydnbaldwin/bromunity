<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Montserrat:wght@300;400;600;700&display=swap" rel="stylesheet">
  <title>Signup</title>
  <style>
    :root {
      --color-white: #FFFFFF;
      --color-light-gray: #D9D9D9;
      --color-black: #070707;
      --color-gray: #696D7D;
      --color-dark-blue: #1D3557;
      --bs-body-bg: var(--color-white);
      --bs-body-color: var(--color-black);
      --bs-primary: var(--color-dark-blue);
      --bs-primary-rgb: 29, 53, 87;
      --bs-secondary: var(--color-gray);
      --bs-secondary-rgb: 105, 109, 125;
      --bs-light: var(--color-light-gray);
      --bs-light-rgb: 217, 217, 217;
      --bs-body-font-family: 'Montserrat', sans-serif;
      --bs-heading-font-family: 'DM Serif Display', serif;
      --bs-gradient: linear-gradient(135deg, var(--color-dark-blue), var(--color-gray));
    }
  </style>
</head>
<body class="min-vh-100 d-flex align-items-center bg-primary bg-gradient">
  <!-- Back Link -->
  <a href="/" aria-label="Back" class="position-fixed top-0 start-0 m-3 z-3 btn btn-light text-primary rounded-pill shadow border-0 d-inline-flex align-items-center gap-2 px-3 py-2">
    <span class="fw-bold">←</span>
    <span class="fw-semibold">Back</span>
  </a>
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-12 col-sm-10 col-md-8 col-lg-5">
        <% if (errorMessage !== null && errorMessage !== "") { %>
          <div class="alert alert-danger" role="alert"><%= errorMessage %></div>
        <% } %>

        <!-- Signup Form -->
        <div class="card shadow rounded-4 border-0 bg-white">
          <div class="card-body p-4 p-md-5">
            <h1 class="h3 mb-4 text-center text-primary">Create Your Account</h1>
            <form action="/authentication/signup" method="post" class="needs-validation" novalidate>
              <div class="mb-3">
                <label for="email" class="form-label text-dark">Email</label>
                <input type="email" id="email" name="email" class="form-control" placeholder="example@email.com" required autofocus>
              </div>

              <div class="mb-4">
                <label for="password" class="form-label text-dark">Password</label>
                <input type="password" id="password" name="password" class="form-control" required>
              </div>

              <button type="submit" class="btn btn-primary bg-primary border-0 text-white fw-semibold w-100">Sign Up</button>
            </form>

            <div class="text-center mt-3">
              <small class="text-muted">Already have an account?
                <a href="/authentication/login" class="link-secondary fw-semibold">Login</a>
              </small>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
</body>
</html>