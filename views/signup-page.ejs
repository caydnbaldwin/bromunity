<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Signup</title>
</head>
<body>
  <% if (errorMessage !== null && errorMessage !== "") { %>
    <p><%= errorMessage %></p>
  <% } %>
  <a href="/">Back</a>
  <h1>signup-page.ejs</h1>
  <form action="/authentication/signup" method="post">
    <label for="email">Email</label>
    <input type="email" id="email" name="email" placeholder="example@email.com" required autofocus>
    <label for="password">Password</label>
    <input type="password" id="password" name="password" required>
    <button type="submit">Sign Up</button>
  </form>
  <p>Already have an account? <a href="/authentication/login">Login</a></p>
</body>
</html>