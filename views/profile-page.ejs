<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Montserrat:wght@300;400;600;700&display=swap" rel="stylesheet">
  <title>Profile</title>
  <style>
    :root {
      --color-white: #FFFFFF;
      --color-light-gray: #D9D9D9;
      --color-black: #070707;
      --color-gray: #696D7D;
      --color-dark-blue: #1D3557;
      --bs-body-bg: var(--color-white);
      --bs-body-color: var(--color-black);
      --bs-primary: var(--color-dark-blue);
      --bs-primary-rgb: 29, 53, 87;
      --bs-secondary: var(--color-gray);
      --bs-secondary-rgb: 105, 109, 125;
      --bs-light: var(--color-light-gray);
      --bs-light-rgb: 217, 217, 217;
      --bs-body-font-family: 'Montserrat', sans-serif;
      --bs-heading-font-family: 'DM Serif Display', serif;
      --bs-gradient: linear-gradient(135deg, var(--color-dark-blue), var(--color-gray));
    }
  </style>
</head>
<body class="d-flex flex-column min-vh-100 bg-body text-body">
  <!-- Navigation -->
  <nav class="navbar bg-primary navbar-dark shadow py-4">
    <div class="container d-flex align-items-center">
      <a href="/" class="navbar-brand d-flex align-items-center gap-2 text-decoration-none text-white">
        <img src="/logo.png" alt="Bromunity Logo" height="35">
        <span class="fs-3 fw-bold">Bromunity</span>
      </a>
      <div class="ms-auto d-flex align-items-center gap-3 flex-wrap justify-content-end">
        <a href="/profiles/feed" class="btn btn-outline-light fw-semibold px-4">Feed</a>
        <a href="/friendships/pending" class="btn btn-outline-light fw-semibold px-4">
          Requests
          <span class="badge bg-light text-primary ms-2"><%= session.friendships.pending.pending %></span>
        </a>
        <a href="/friendships/accepted" class="btn btn-outline-light fw-semibold px-4">
          Friends
          <span class="badge bg-light text-primary ms-2"><%= session.friendships.accepted.accepted %></span>
        </a>
        <a href="/profiles/profile/add" class="btn btn-light text-primary fw-semibold px-4">Add Profile</a>
        <a href="/authentication/logout" class="btn btn-light text-primary fw-semibold px-4">Logout</a>
      </div>
    </div>
  </nav>

  <!-- Profile Content -->
  <main class="flex-grow-1 py-5 bg-light">
    <div class="container">
      <div class="mb-4 text-center">
        <h1 class="display-5 fw-bold text-primary">Your Gaming Profiles</h1>
        <p class="text-secondary mb-0">Manage and update your Bromunity presence.</p>
      </div>

      <% if (errorMessage !== null && errorMessage !== "") { %>
        <div class="alert alert-danger" role="alert"><%= errorMessage %></div>
      <% } %>

      <% if (session.profiles !== null && session.profiles.length > 0) { %>
        <div class="row g-4">
          <% session.profiles.forEach(function(profile) { %>
            <div class="col-12 col-md-6 col-xl-4">
              <div class="card h-100 shadow-sm border-0">
                <div class="card-body d-flex flex-column gap-2">
                  <h2 class="h4 text-primary mb-0"><%= session.person.first_name %>'s Profile</h2>
                  <div class="d-flex flex-wrap gap-2">
                    <a href="/profiles/profile/edit/<%= profile.person_id %>/<%= profile.game_id %>" class="btn btn-outline-primary btn-sm fw-semibold">Edit</a>
                    <a href="/profiles/profile/delete/<%= profile.person_id %>/<%= profile.game_id %>" class="btn btn-outline-danger btn-sm fw-semibold">Delete</a>
                  </div>
                  <div class="mt-2">
                    <% Object.keys(profile).forEach(function(attribute) { %>
                      <div class="d-flex justify-content-between border-bottom py-1">
                        <span class="fw-semibold text-secondary text-uppercase small"><%= attribute.replace(/_/g, ' ') %></span>
                        <span class="text-dark"><%= profile[attribute] %></span>
                      </div>
                    <% }); %>
                  </div>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <div class="text-center py-5">
          <p class="lead text-secondary mb-4">No profiles exist for your account yet.</p>
          <a href="/profiles/profile/add" class="btn btn-primary bg-primary border-0 text-white fw-semibold px-4">Create Your First Profile</a>
        </div>
      <% } %>
    </div>
  </main>

  <!-- Footer -->
  <footer class="bg-primary text-light py-3">
    <div class="container text-center small">
      <p class="mb-0 d-flex justify-content-center align-items-center gap-2 flex-wrap">
        <img src="/logo.png" alt="bromunity logo" height="15">
        <span>&copy; 2025 Bromunity. Every single right ever is 100% totally reserved. Like don't even try us.</span>
        <a href="https://www.youtube.com/watch?v=dQw4w9WgXcQ" target="_blank" class="link-light text-decoration-none">See our rights</a>
      </p>
    </div>
  </footer>
</body>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
</html>