<!-- Caydn Baldwin, Brady Bates, Jacob Woodward, Peter Young -->
<!-- Description: This page is to display all of a person's profiles. It is their main
  landing page once they log in. Here they will view all their profiles, have the option to add profiles, and
  navigate to any other pages. -->

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Montserrat:wght@300;400;600;700&display=swap" rel="stylesheet">
  <title>Profile</title>
  <style>
    /* Page theme variables and layout helpers */
    :root {
      --color-white: #FFFFFF;
      --color-light-gray: #D9D9D9;
      --color-black: #070707;
      --color-gray: #696D7D;
      --color-dark-blue: #1D3557;
      --bs-body-bg: var(--color-white);
      --bs-body-color: var(--color-black);
      --bs-primary: var(--color-black);
      --bs-primary-rgb: 0, 0, 0;
      --bs-secondary: var(--color-gray);
      --bs-secondary-rgb: 105, 109, 125;
      --bs-light: var(--color-light-gray);
      --bs-light-rgb: 217, 217, 217;
      --bs-body-font-family: 'Montserrat', sans-serif;
      --bs-heading-font-family: 'DM Serif Display', serif;
      --bs-gradient: linear-gradient(135deg, var(--color-dark-blue), var(--color-gray));
    }

    /* Responsive grid to display profile cards */
    .profile-scroll {
      display: grid;
      gap: 1.5rem;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      align-items: stretch;
    }

    /* Ensure cards fill their grid columns cleanly */
    .profile-scroll .profile-card {
      width: 100%;
      min-width: 0;
      word-wrap: break-word;
      overflow-wrap: anywhere;
    }

    /* Row layout for attribute label/value pairs */
    .profile-attribute-row {
      display: flex;
      justify-content: space-between;
      gap: 0.75rem;
      align-items: flex-start;
      flex-wrap: wrap;
    }


    
  </style>
</head>
<body class="d-flex flex-column min-vh-100 bg-body text-body">
  <!-- Navigation -->
  <nav class="navbar bg-primary navbar-dark shadow py-4">
    <div class="container d-flex align-items-center">
      <a href="/profiles/profile" class="navbar-brand d-flex align-items-center gap-2 text-decoration-none text-white">
        <img src="/logo.png" alt="Bromunity Logo" height="35">
        <span class="fs-3 fw-bold">Bromunity</span>
      </a>
      <div class="ms-auto d-flex align-items-center gap-3 flex-wrap justify-content-end">
        <!-- Only admins see the Persons link -->
        <% if (session.authentication.role === "admin") { %>
          <a href="/persons/persons" class="btn btn-outline-light fw-semibold px-4">Persons</a>
        <% } %>
        <a href="/profiles/feed" class="btn btn-outline-light fw-semibold px-4">Feed</a>
        <a href="/friendships/pending" class="btn btn-outline-light fw-semibold px-4">
          Requests
          <!-- Count of pending friendship requests -->
          <span class="badge bg-light text-primary ms-2"><%= session.friendships.pending.pending %></span>
        </a>
        <a href="/friendships/accepted" class="btn btn-outline-light fw-semibold px-4">
          Friends
          <!-- Count of accepted friends -->
          <span class="badge bg-light text-primary ms-2"><%= session.friendships.accepted.accepted %></span>
        </a>
        <!-- Show Add Profile if viewing own profile; otherwise link to Profile overview -->
        <% if (isOwnProfile) { %>
          <a href="/profiles/profile/add" class="btn btn-light text-primary fw-semibold px-4">Add Profile</a>
        <% } else { %>
          <a href="/profiles/profile" class="btn btn-light text-primary fw-semibold px-4">Profile</a>
        <% } %>
        <a href="/authentication/logout" class="btn btn-light text-primary fw-semibold px-4">Logout</a>
      </div>
    </div>
  </nav>

  <!-- Profile Content -->
  <main class="flex-grow-1 py-5" style="background-color: var(--color-black);">
    <div class="container">
      <div class="mb-4 text-center">
        <!-- Dynamic page title: shows person name if available -->
        <h1 class="display-5 fw-bold text-white"><%= isOwnProfile ? (viewedPerson ? viewedPerson.first_name + ' ' + viewedPerson.last_name : session.person.first_name + ' ' + (session.person.last_name || '')) : (viewedPerson ? viewedPerson.first_name + ' ' + viewedPerson.last_name : 'Profile') %></h1>
        <!-- Subtitle varies for own vs viewing someone else -->
        <p class="text-light mb-0"><%= isOwnProfile ? 'Manage and update your Bromunity presence.' : 'Viewing user\'s gaming profiles.' %></p>
      </div>

      <!-- Error banner if an error message is present -->
      <% if (errorMessage !== null && errorMessage !== "") { %>
        <div class="alert alert-danger" role="alert"><%= errorMessage %></div>
      <% } %>

      <!-- Render profiles if any exist in session -->
      <% if (session.profiles !== null && session.profiles.length > 0) { %>
        <div class="profile-scroll">
          <!-- Iterate over each profile and render a card -->
          <% session.profiles.forEach(function(profile) { %>
            <div class="card profile-card h-100 shadow-sm border-0">
              <div class="card-body d-flex flex-column gap-2">
                <!-- Card title shows person's name and game title -->
                <h2 class="h4 text-primary mb-0"><%= (viewedPerson ? viewedPerson.first_name : (isOwnProfile ? session.person.first_name : '')) %>'s <%= profile.game_title %> Profile</h2>
                <!-- Edit/Delete controls only for your own profiles -->
                <% if (isOwnProfile) { %>
                  <div class="d-flex flex-wrap gap-2">
                    <a href="/profiles/profile/edit/<%= profile.person_id %>/<%= profile.game_id %>" class="btn btn-primary bg-primary border-0 text-white btn-sm fw-semibold">Edit</a>
                    <a href="/profiles/profile/delete/<%= profile.person_id %>/<%= profile.game_id %>" class="btn btn-outline-secondary btn-sm fw-semibold">Delete</a>
                  </div>
                <% } %>
                <div class="mt-2">
                  <!-- Display attribute label/value rows, skipping IDs and title -->
                  <% Object.keys(profile).forEach(function(attribute) { %>
                    <%
                      // Determine whether to display the current attribute.
                      // Hide 'gamertag' when viewing someone else's profile and friendship status between viewer and viewed is not Accepted.
                      const viewerId = session && session.person ? session.person.person_id : null;
                      const viewedId = (typeof viewedPerson !== 'undefined' && viewedPerson && viewedPerson.person_id) ? viewedPerson.person_id : (profile && profile.person_id ? profile.person_id : null);

                      // Helper to check Accepted friendship for given pair in an array of friendships
                      function isAcceptedInList(list) {
                        try {
                          return Array.isArray(list) && list.some(f => (
                            f && f.status === 'Accepted' && (
                              (f.person_id_1 === viewerId && f.person_id_2 === viewedId) ||
                              (f.person_id_2 === viewerId && f.person_id_1 === viewedId)
                            )
                          ));
                        } catch (_) {
                          return false;
                        }
                      }

                      // Check multiple possible session locations for accepted friendships
                      const acceptedFromSessionAccepted = isAcceptedInList(session && session.accepted ? session.accepted : null);
                      const acceptedFromFriendshipsAccepted = isAcceptedInList(session && session.friendships && Array.isArray(session.friendships.accepted) ? session.friendships.accepted : null);
                      const acceptedFromFriendshipsReceived = isAcceptedInList(session && session.friendships && Array.isArray(session.friendships.received) ? session.friendships.received : null);
                      const acceptedFromFriendshipsSent = isAcceptedInList(session && session.friendships && Array.isArray(session.friendships.sent) ? session.friendships.sent : null);

                      const isAcceptedFriendship = !!(acceptedFromSessionAccepted || acceptedFromFriendshipsAccepted || acceptedFromFriendshipsReceived || acceptedFromFriendshipsSent);

                      const canViewSensitive = !!isOwnProfile || isAcceptedFriendship;
                      const isSensitiveAttribute = attribute === 'gamertag';
                      const shouldShowAttribute = attribute !== 'person_id' && attribute !== 'game_id' && attribute !== 'game_title' && (!isSensitiveAttribute || canViewSensitive);
                    %>
                    <% if (shouldShowAttribute) { %>
                      <div class="profile-attribute-row border-bottom py-1">
                        <!-- Attribute label (underscores replaced with spaces) -->
                        <span class="fw-semibold text-dark text-uppercase small flex-grow-1"><%= attribute.replace(/_/g, ' ') %></span>
                        <!-- Attribute value with safe wrapping -->
                        <span class="text-dark text-break flex-grow-1 text-end"><%= profile[attribute] %></span>
                      </div>
                    <% } %>
                  <% }); %>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
       <!-- Empty state when no profiles exist -->
      <% } else { %>
        <div class="text-center py-5">
          <p class="lead text-light mb-4"><%= isOwnProfile ? 'No profiles exist for your account yet.' : 'No profiles to display for this user.' %></p>
           <!-- Encourage creating first profile when it's your own -->
          <% if (isOwnProfile) { %>
            <a href="/profiles/profile/add" class="btn btn-primary bg-primary border-0 text-white fw-semibold px-4">Create Your First Profile</a>
          <% } %>
        </div>
      <% } %>
    </div>
  </main>

  <!-- Footer -->
  <footer class="bg-primary text-light py-3">
    <div class="container text-center small">
      <p class="mb-0 d-flex justify-content-center align-items-center gap-2 flex-wrap">
        <img src="/logo.png" alt="bromunity logo" height="15">
        <span>&copy; 2025 Bromunity. Every single right ever is 100% totally reserved. Like don't even try us.</span>
        <a href="https://www.youtube.com/watch?v=dQw4w9WgXcQ" target="_blank" class="link-light">See our rights</a>
      </p>
    </div>
  </footer>
</body>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
</html>