<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Montserrat:wght@300;400;600;700&display=swap" rel="stylesheet">
  <title>Feed</title>
</head>
<body>
  <% if (errorMessage !== null && errorMessage !== "") { %>
    <p><%= errorMessage %></p>
  <% } %>
  <h1>profile-page.ejs</h1>
  <a href="/authentication/logout">Logout</a>
  <a href="/profiles/feed">Feed</a>
  <a href="/friendships/pending">Requests: <%= session.friendships.pending.pending %></a>
  <a href="/friendships/accepted">Friends: <%= session.friendships.accepted.accepted %></a>
  <a href="/profiles/profile/add">Add Profile</a>
  <% if (session.profiles !== null && session.profiles.length > 0) { %>
    <% for (let profile of session.profiles) { %>
      <p>Profile: <%= session.person.first_name %></p>
      <!-- Naming conventions for routes? -->
      <!-- POST for creation, PUT for update, but would PUT work with <form>? -->
      <!-- Use DELETE /profiles/profile/:person_id/:game_id vs GET /profiles/profile/delete/:person_id/:game_id for delete operations -->
      <!-- see file:///c:/users/caydn/bromunity/api/profiles/ProfilesRouter.js#L8 -->
      <a href="/profiles/profile/edit/<%= profile.person_id %>/<%= profile.game_id %>">Edit Profile</a>
      <a href="/profiles/profile/delete/<%= profile.person_id %>/<%= profile.game_id %>">Delete Profile</a>
      <% for (let attribute in profile) { %>
        <p><%= attribute %>: <%= profile[attribute] %></p>
      <% } %>
    <% } %>
  <% } else { %>
    <p>No profiles exist for your account.</p>
  <% } %>
</body>
</html>