<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Montserrat:wght@300;400;600;700&display=swap" rel="stylesheet">
  <title>Add Profile</title>
  <style>
    :root {
      --color-white: #FFFFFF;
      --color-light-gray: #D9D9D9;
      --color-black: #070707;
      --color-gray: #696D7D;
      --color-dark-blue: #1D3557;
      --bs-body-bg: var(--color-white);
      --bs-body-color: var(--color-black);
      /* --bs-primary: var(--color-dark-blue);
      --bs-primary-rgb: 29, 53, 87; */
      --bs-primary: var(--color-black);
      --bs-primary-rgb: 0, 0, 0;
      --bs-secondary: var(--color-gray);
      --bs-secondary-rgb: 105, 109, 125;
      --bs-light: var(--color-light-gray);
      --bs-light-rgb: 217, 217, 217;
      --bs-body-font-family: 'Montserrat', sans-serif;
      --bs-heading-font-family: 'DM Serif Display', serif;
      --bs-gradient: linear-gradient(135deg, var(--color-dark-blue), var(--color-gray));
    }
  </style>
</head>
<!-- <body class="d-flex flex-column min-vh-100 bg-primary bg-gradient"> -->
<body class="d-flex flex-column min-vh-100 bg-primary">
  <!-- Navigation -->
  <nav class="navbar bg-primary navbar-dark shadow py-4">
    <div class="container d-flex align-items-center">
      <a href="/" class="navbar-brand d-flex align-items-center gap-2 text-decoration-none text-white">
        <img src="/logo.png" alt="Bromunity Logo" height="35">
        <span class="fs-3 fw-bold">Bromunity</span>
      </a>
      <div class="ms-auto d-flex align-items-center gap-3 flex-wrap justify-content-end">
        <a href="/profiles/feed" class="btn btn-outline-light fw-semibold px-4">Feed</a>
        <a href="/profiles/profile/<%= session.person.person_id %>" class="btn btn-outline-light fw-semibold px-4">Profiles</a>
        <a href="/authentication/logout" class="btn btn-light text-primary fw-semibold px-4">Logout</a>
      </div>
    </div>
  </nav>

  <!-- Add Profile Form -->
  <main class="flex-grow-1 d-flex align-items-center py-5">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-7">
          <% if (errorMessage !== null && errorMessage !== "") { %>
            <div class="alert alert-danger" role="alert"><%= errorMessage %></div>
          <% } %>

          <div class="card shadow rounded-4 border-0 bg-white">
            <div class="card-body p-4 p-md-5">
              <div class="d-flex align-items-center mb-4">
                <a href="/profiles/profile/<%= session.person.person_id %>" class="text-primary fw-bold text-decoration-none fs-3">←</a>
                <h1 class="h3 mb-0 flex-grow-1 text-center text-primary">Add a Game Profile</h1>
                <span class="opacity-0 fs-3">←</span>
              </div>

              <form action="/profiles/profile/add" method="post" class="needs-validation" novalidate>
                <div class="row g-3">
                  <div class="col-12">
                    <label for="game_id" class="form-label text-dark">Game Title</label>
                    <select name="game_id" id="game_id" class="form-select" required>
                      <% session.games.forEach(function(game) { %>
                        <option value="<%= game.game_id %>"><%= game.game_title %></option>
                      <% }); %>
                    </select>
                  </div>

                  <div class="col-md-6">
                    <label for="gaming_platform" class="form-label text-dark">Gaming Platform</label>
                    <select name="gaming_platform" id="gaming_platform" class="form-select" required>
                      <option value="PC">PC</option>
                      <option value="PlayStation">PlayStation</option>
                      <option value="Xbox">Xbox</option>
                      <option value="Nintendo Switch">Nintendo Switch</option>
                      <option value="Mobile">Mobile</option>
                    </select>
                  </div>

                  <div class="col-md-6">
                    <label for="hours_of_gameplay" class="form-label text-dark">Hours of Gameplay</label>
                    <input type="number" id="hours_of_gameplay" name="hours_of_gameplay" class="form-control" placeholder="100" required>
                  </div>

                  <div class="col-12">
                    <label for="description" class="form-label text-dark">Description</label>
                    <input type="text" id="description" name="description" class="form-control" placeholder="My normal role is..." required>
                  </div>
                </div>

                <button type="submit" class="btn btn-primary bg-primary border-0 text-white fw-semibold w-100 mt-4">Create Profile</button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <!-- Footer -->
  <footer class="bg-primary text-light py-3">
    <div class="container text-center small">
      <p class="mb-0 d-flex justify-content-center align-items-center gap-2 flex-wrap">
        <img src="/logo.png" alt="bromunity logo" height="15">
        <span>&copy; 2025 Bromunity. Every single right ever is 100% totally reserved. Like don't even try us.</span>
        <a href="https://www.youtube.com/watch?v=dQw4w9WgXcQ" target="_blank" class="link-light text-decoration-none">See our rights</a>
      </p>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
</body>
</html>