<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Montserrat:wght@300;400;600;700&display=swap" rel="stylesheet">
  <title>Add Profile</title>
</head>
<body class="min-vh-100 d-flex align-items-center" style="background: linear-gradient(135deg, #1D3557 0%, #696D7D 100%);">
  <a href="/profiles/profile/<%= session.person.person_id %>" aria-label="Back" class="position-fixed top-0 start-0 m-3 z-3 btn btn-light rounded-pill shadow d-inline-flex align-items-center gap-2 border-0 px-3 py-2" style="background-color:#FFFFFF; color:#1D3557;">
    <span class="fw-bold">←</span>
    <span class="fw-semibold">Back</span>
  </a>

  <div class="container">
    <div class="row justify-content-center">
      <div class="col-12 col-md-10 col-lg-7">
        <% if (errorMessage !== null && errorMessage !== "") { %>
          <div class="alert alert-danger" role="alert"><%= errorMessage %></div>
        <% } %>

        <div class="card shadow rounded-4 border-0" style="background-color:#FFFFFF;">
          <div class="card-body p-4 p-md-5">
            <h1 class="h3 mb-4 text-center" style="color:#1D3557; font-family: 'DM Serif Display', serif;">Add a Game Profile</h1>

            <form action="/profiles/profile/add" method="post" class="needs-validation" novalidate>
              <div class="row g-3">
                <div class="col-12">
                  <label for="game_id" class="form-label" style="color:#070707;">Game Title</label>
                  <select name="game_id" id="game_id" class="form-select" required>
                    <% for (game of session.games) { %>
                      <option value=<%= game.game_id %>><%= game.game_title %></option>
                    <% } %>
                  </select>
                </div>

                <div class="col-md-6">
                  <label for="gaming_platform" class="form-label" style="color:#070707;">Gaming Platform</label>
                  <select name="gaming_platform" id="gaming_platform" class="form-select" required>
                    <option value="PC">PC</option>
                    <option value="PlayStation">PlayStation</option>
                    <option value="Xbox">Xbox</option>
                    <option value="Nintendo Switch">Nintendo Switch</option>
                    <option value="Mobile">Mobile</option>
                  </select>
                </div>

                <div class="col-md-6">
                  <label for="hours_of_gameplay" class="form-label" style="color:#070707;">Hours of Gameplay</label>
                  <input type="number" id="hours_of_gameplay" name="hours_of_gameplay" class="form-control" placeholder="100" required>
                </div>

                <div class="col-12">
                  <label for="description" class="form-label" style="color:#070707;">Description</label>
                  <input type="text" id="description" name="description" class="form-control" placeholder="My normal role is..." required>
                </div>
              </div>

              <button type="submit" class="btn w-100 mt-4" style="background-color:#1D3557; color:#FFFFFF;">Create Profile</button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
</body>
</html>