<!--
This is the landing (home) page for the Bromunity website.
It displays a welcome message, a background animation, and
buttons that allow users to sign up or log in.-->
<!DOCTYPE html>
<html lang="en">
<head>

  <!--Basic page metadata and responsive settings-->
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!--Browser tab icon-->
  <link rel="icon" href="/favicon.ico" type="image/x-icon">

  <!--Bootstrap CSS for layout and styling-->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
  <!--Google Fonts used across the site-->
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Montserrat:wght@300;400;600;700&display=swap" rel="stylesheet">
  <title>Bromunity</title>
  <!--Custom CSS variables and styling-->
  <style>
  :root {
    --color-white: #FFFFFF;
    --color-light-gray: #D9D9D9;
    --color-black: #070707;
    --color-gray: #696D7D;
    /* --color-dark-blue: #1D3557; */
    --bs-body-bg: var(--color-white);
    --bs-body-color: var(--color-black);
    --bs-primary: var(--color-black);
    --bs-primary-rgb: 0, 0, 0;
    /* --bs-primary: var(--color-dark-blue);
    --bs-primary-rgb: 29, 53, 87; */
    --bs-secondary: var(--color-gray);
    --bs-secondary-rgb: 105, 109, 125;
    --bs-light: var(--color-light-gray);
    --bs-light-rgb: 217, 217, 217;
    --bs-body-font-family: 'Montserrat', sans-serif;
    --bs-headings-font-family: 'DM Serif Display', serif;
    --bs-gradient: linear-gradient(135deg, var(--color-dark-blue), var(--color-gray));
  }

  /* Container for the hero section */
  .hero-section {
    position: relative;
    overflow: hidden;
  }
  /* Full-screen animated background GIF */
  .gif-background {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    min-width: 100%;
    min-height: 100%;
    z-index: 0;
    object-fit: cover;
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    z-index: 1; 
  }
</style>
</head>
<body class="d-flex flex-column min-vh-100 bg-body text-body">
  <!--Navigation Bar-->
  <nav class="navbar bg-primary navbar-dark shadow py-4" style="background-color: black !important;">
    <div class="container d-flex align-items-center">

      <!--Logo and site name-->
      <a href="/" class="navbar-brand d-flex align-items-center gap-2 text-decoration-none text-white">
        <img src="/logo.png" alt="Bromunity Logo" height="35">
        <span class="fs-3 fw-bold">Bromunity</span>
      </a>
    </div>
  </nav>

  <!--Hero Section-->
  <section class="hero-section flex-grow-1 d-flex align-items-center bg-primary bg-gradient text-white">
    
    <!--Animated background image-->
    <img 
      class="gif-background" 
      src="/img/matrix.gif" 
      alt="Bromunity Matrix Background">
    <!--Main content displayed on top of the background-->
    <div class="container hero-content text-center py-5">
      <h2 class="display-4 fw-bold mb-3">Welcome to Bromunity</h2>

      <!--Short tagline-->
      <p class="fs-5 fw-light text-light opacity-75 mb-4">Connect, collaborate, and build your community</p>

      <!--Call-to-action buttons-->
      <div class="d-flex flex-column flex-sm-row justify-content-center gap-3">
        <a href="/authentication/signup" class="btn btn-light text-dark fw-semibold px-5 py-3">Get Started</a>
        <a href="/authentication/login" class="btn btn-outline-light fw-semibold px-5 py-3">Sign In</a>
      </div>
    </div>
  </section>

  <!--Footer-->
  <footer class="bg-primary text-light py-3" style="background-color: black !important;">
    <div class="container text-center small">
      <p class="mb-0 d-flex justify-content-center align-items-center gap-2 flex-wrap">
        <img src="/logo.png" alt="bromunity logo" height="15">
        <span>&copy; 2025 Bromunity. Every single right ever is 100% totally reserved. Like don't even try us.</span>
        <a href="https://www.youtube.com/watch?v=dQw4w9WgXcQ" target="_blank" class="link-light">See our rights</a>
      </p>
    </div>
  </footer>

  <!--Bootstrap JavaScript bundle-->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
</body>
</html>