<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" href="/favicon.ico" type="image/x-icon">

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Montserrat:wght@300;400;600;700&display=swap" rel="stylesheet">
  <title>Bromunity</title>
  <style>
    :root {
      --color-white: #FFFFFF;
      --color-light-gray: #D9D9D9;
      --color-black: #070707;
      --color-gray: #696D7D;
      --color-dark-blue: #1D3557;
    }

    * {
      font-family: 'Montserrat', sans-serif;
    }

    body {
      background-color: var(--color-white);
      color: var(--color-black);
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      min-height: 100vh;
    }

    nav {
      background-color: var(--color-dark-blue);
      box-shadow: 0 2px 8px rgba(7, 7, 7, 0.1);
      padding: 1rem 2rem;
      height: 15vh;
      display: flex;
      align-items: center;
    }

    .nav-brand {
      font-family: 'DM Serif Display', serif;
      font-size: 1.8rem;
      font-weight: 700;
      color: var(--color-white);
      margin: 0;
      letter-spacing: 1px;
    }

    .nav-links {
      display: flex;
      gap: 2rem;
      align-items: center;
      margin-left: auto;
    }

    .nav-link {
      text-decoration: none;
      color: var(--color-white);
      font-weight: 600;
      font-size: 0.95rem;
      transition: all 0.3s ease;
      padding: 0.5rem 1rem;
      border-radius: 4px;
    }

    .nav-link:hover {
      background-color: var(--color-gray);
      color: var(--color-white);
      transform: translateY(-2px);
    }

    .nav-link.btn-primary {
      background-color: var(--color-light-gray);
      color: var(--color-black);
      border: none;
    }

    .nav-link.btn-primary:hover {
      background-color: var(--color-white);
      color: var(--color-dark-blue);
    }

    .hero-section {
      background: linear-gradient(135deg, var(--color-dark-blue) 0%, var(--color-gray) 100%);
      color: var(--color-white);
      padding: 2rem;
      text-align: center;
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
    }

    .hero-title {
      font-family: 'DM Serif Display', serif;
      font-size: 3.5rem;
      font-weight: 700;
      margin-bottom: 1rem;
      letter-spacing: 2px;
    }

    .hero-subtitle {
      font-size: 1.3rem;
      font-weight: 300;
      margin-bottom: 2.5rem;
      color: var(--color-light-gray);
    }

    .btn-custom {
      display: inline-block;
      padding: 0.8rem 2.5rem;
      margin: 0.5rem;
      font-weight: 600;
      text-decoration: none;
      border-radius: 6px;
      transition: all 0.3s ease;
      border: 2px solid transparent;
      font-size: 1rem;
      cursor: pointer;
    }

    .btn-signup {
      background-color: var(--color-light-gray);
      color: var(--color-black);
    }

    .btn-signup:hover {
      background-color: var(--color-white);
      color: var(--color-dark-blue);
      transform: translateY(-3px);
      box-shadow: 0 8px 20px rgba(7, 7, 7, 0.15);
    }

    .btn-login {
      background-color: transparent;
      color: var(--color-white);
      border: 2px solid var(--color-white);
    }

    .btn-login:hover {
      background-color: var(--color-white);
      color: var(--color-dark-blue);
      transform: translateY(-3px);
      box-shadow: 0 8px 20px rgba(255, 255, 255, 0.2);
    }

    footer {
      background-color: var(--color-dark-blue);
      color: var(--color-light-gray);
      text-align: center;
      height: 5vh;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.75rem;
    }

    footer p {
      margin: 0;
    }

    @media (max-width: 768px) {
      .hero-title {
        font-size: 2rem;
      }

      .hero-subtitle {
        font-size: 1rem;
      }

      .nav-links {
        gap: 1rem;
      }
    }
  </style>
</head>
<body>
  <!-- Navigation -->
  <nav class="navbar-custom">
    <div style="display: flex; align-items: center; width: 100%;">
      <h1 class="nav-brand"><a href="/" style="text-decoration: none;" class="nav-brand"><img src="/logo.png" alt="Bromunity Logo" height="35px">&nbsp;&nbsp;Bromunity</a></h1>
      <div class="nav-links">
        <a href="/authentication/signup" class="nav-link btn-primary">Sign Up</a>
        <a href="/authentication/login" class="nav-link">Login</a>
      </div>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="hero-section">
    <h2 class="hero-title">Welcome to Bromunity</h2>
    <p class="hero-subtitle">Connect, collaborate, and build your community</p>
    <div>
      <a href="/authentication/signup" class="btn-custom btn-signup">Get Started</a>
      <a href="/authentication/login" class="btn-custom btn-login">Sign In</a>
    </div>
  </section>

  <!-- Footer -->
  <footer>
    <p>&copy; 2025 Bromunity. Every single right ever is 100% totally reserved. Like don't even try us. <a href="https://www.youtube.com/watch?v=dQw4w9WgXcQ" target="_blank" style="color: darkgrey;">See our rights</a></p>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
</body>
</html>