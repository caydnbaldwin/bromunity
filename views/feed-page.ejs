<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Montserrat:wght@300;400;600;700&display=swap" rel="stylesheet">
  <title>Feed</title>
</head>
<body>
  <% if (errorMessage !== null && errorMessage !== "") { %>
    <p><%= errorMessage %></p>
  <% } %>
  <h1>feed-page.ejs</h1>
  <a href="/authentication/logout">Logout</a>
  <% if (session?.authentication !== null && session?.authentication !== "") { %>
    <% for (let attribute in session.authentication) { %>
      <p><%= attribute %>: <%= session.authentication[attribute] %></p>
    <% } %>
  <% } %>
</body>
</html>