<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Montserrat:wght@300;400;600;700&display=swap" rel="stylesheet">
  <title>Feed</title>
</head>
<body>
  <% if (errorMessage !== null && errorMessage !== "") { %>
    <p><%= errorMessage %></p>
  <% } %>
  <h1>feed-page.ejs</h1>
  <a href="/authentication/logout">Logout</a>
  <a href="/profiles/profile/<%= session.person.person_id %>">Profile</a>
  <% if (session?.feed?.person) { %>
    <p>First Name: <%= session.feed.person.first_name%></p>
    <p>Gender: <%= session.feed.person.gender%></p>
    <a href="/friendships/nofriend/<%= session.feed.person.person_id %>">No Friend</a>
    <a href="/friendships/yesfriend/<%= session.feed.person.person_id %>">Friend</a>
  <% } else { %>
    <p>No more people to show in your feed.</p>
  <% } %>
  <% if (session?.feed?.profiles !== null && session?.feed?.profiles.length > 0) { %>
    <% for (const profile of session.feed.profiles) { %>
      <p>Game: <%= profile.game_title %></p>
      <p>Gaming Platform: <%= profile.gaming_platform %></p>
      <p>Description: <%= profile.description %></p>
      <p>Hours of Gameplay: <%= profile.hours_of_gameplay %></p>
    <% } %>
  <% } %>
</body>
</html>