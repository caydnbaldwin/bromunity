<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Montserrat:wght@300;400;600;700&display=swap" rel="stylesheet">
  <title>Feed</title>
  <style>
    :root {
      --color-white: #FFFFFF;
      --color-light-gray: #D9D9D9;
      --color-black: #070707;
      --color-gray: #696D7D;
      --color-dark-blue: #1D3557;
      --bs-body-bg: var(--color-white);
      --bs-body-color: var(--color-black);
      --bs-primary: var(--color-black);
      --bs-primary-rgb: 0, 0, 0;
      --bs-secondary: var(--color-gray);
      --bs-secondary-rgb: 105, 109, 125;
      --bs-light: var(--color-light-gray);
      --bs-light-rgb: 217, 217, 217;
      --bs-body-font-family: 'Montserrat', sans-serif;
      --bs-heading-font-family: 'DM Serif Display', serif;
      --bs-gradient: linear-gradient(135deg, var(--color-dark-blue), var(--color-gray));
    }

    .feed-card { border: 0; }
  </style>
</head>
<body class="d-flex flex-column min-vh-100 bg-body text-body">
  <!-- Navigation -->
  <nav class="navbar bg-primary navbar-dark shadow py-4">
    <div class="container d-flex align-items-center">
      <a href="/" class="navbar-brand d-flex align-items-center gap-2 text-decoration-none text-white">
        <img src="/logo.png" alt="Bromunity Logo" height="35">
        <span class="fs-3 fw-bold">Bromunity</span>
      </a>
      <div class="ms-auto d-flex align-items-center gap-3 flex-wrap justify-content-end">
        <% if (session.authentication.role === "admin") { %>
          <a href="/authentication/editusers" class="btn btn-outline-light fw-semibold px-4">Users</a>
        <% } %>
        <a href="/profiles/feed" class="btn btn-outline-light fw-semibold px-4">Feed</a>
        <a href="/friendships/pending" class="btn btn-outline-light fw-semibold px-4">
          Requests
          <span class="badge bg-light text-primary ms-2"><%= (session.friendships && session.friendships.sent && session.friendships.received) ? (session.friendships.sent.length + session.friendships.received.length) : (session.friendships && session.friendships.pending ? session.friendships.pending.pending : 0) %></span>
        </a>
        <a href="/friendships/accepted" class="btn btn-outline-light fw-semibold px-4">
          Friends
          <span class="badge bg-light text-primary ms-2"><%= (session.friendships && session.friendships.accepted && typeof session.friendships.accepted.accepted !== 'undefined') ? session.friendships.accepted.accepted : 0 %></span>
        </a>
        <a href="/profiles/profile/<%= session.person.person_id %>" class="btn btn-light text-primary fw-semibold px-4">Profile</a>
        <a href="/authentication/logout" class="btn btn-light text-primary fw-semibold px-4">Logout</a>
      </div>
    </div>
  </nav>

  <!-- Feed Content -->
  <main class="flex-grow-1 py-5 bg-light">
    <div class="container">
      

      <% if (errorMessage !== null && errorMessage !== "") { %>
        <div class="alert alert-danger" role="alert"><%= errorMessage %></div>
      <% } %>

      <% if (session?.feed?.person && session.feed.person.person_id) { %>
        <div class="mb-4 text-center">
          <h1 class="display-6 fw-bold text-primary">Your Feed</h1>
          <p class="text-secondary mb-0">Discover new connections and game profiles.</p>
        </div>
        <div class="card shadow-sm feed-card mb-4">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-2">
              <h2 class="h5 text-primary mb-0"><%= session.feed.person.first_name %></h2>
              <div class="d-flex gap-2">
                <a href="/friendships/nofriend/<%= session.feed.person.person_id %>" class="btn btn-outline-secondary btn-sm fw-semibold">Pass</a>
                <a href="/friendships/yesfriend/<%= session.feed.person.person_id %>" class="btn btn-primary bg-primary border-0 text-white btn-sm fw-semibold">Add Friend</a>
              </div>
            </div>
            <div class="row g-2">
              <div class="col-md-6">
                <div class="d-flex justify-content-between border-bottom py-1">
                  <span class="fw-semibold text-dark text-uppercase small">Gender</span>
                  <span class="text-dark"><%= session.feed.person.gender %></span>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% } else { %>
        <div class="text-center py-5">
          <p class="lead text-secondary mb-4 greentext">No more people to show in your feed.</p>
          <a href="/profiles/profile/<%= session.person.person_id %>" class="btn btn-primary bg-primary border-0 text-white fw-semibold px-4">View Your Profile</a>
        </div>
      <% } %>

      <% if (session?.feed?.profiles !== null && session?.feed?.profiles.length > 0) { %>
        <div class="row g-4">
          <% for (const profile of session.feed.profiles) { %>
            <div class="col-12 col-md-6 col-lg-4">
              <div class="card h-100 shadow-sm border-0">
                <div class="card-body d-flex flex-column gap-2">
                  <h3 class="h6 text-primary mb-0"><%= profile.game_title %></h3>
                  <div class="d-flex justify-content-between border-bottom py-1">
                    <span class="fw-semibold text-dark text-uppercase small">Gaming Platform</span>
                    <span class="text-dark text-end"><%= profile.gaming_platform %></span>
                  </div>
                  <div class="d-flex justify-content-between border-bottom py-1">
                    <span class="fw-semibold text-dark text-uppercase small">Description</span>
                    <span class="text-dark text-end text-break"><%= profile.description %></span>
                  </div>
                  <div class="d-flex justify-content-between py-1">
                    <span class="fw-semibold text-dark text-uppercase small">Hours of Gameplay</span>
                    <span class="text-dark text-end"><%= profile.hours_of_gameplay %></span>
                  </div>
                </div>
              </div>
            </div>
          <% } %>
        </div>
      <% } %>
    </div>
  </main>

  <!-- Footer -->
  <footer class="bg-primary text-light py-3 mt-auto" style="background-color: #1D3557;">
    <div class="container text-center small">
      <p class="mb-0 d-flex justify-content-center align-items-center gap-2 flex-wrap">
        <img src="/logo.png" alt="bromunity logo" height="15">
        <span>&copy; 2025 Bromunity. All rights reserved.</span>
      </p>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
</body>
</html>